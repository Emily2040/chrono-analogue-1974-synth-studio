  "patch_rules": {
    "allowed_port_pairs": [
      {
        "from": "audio_out",
        "to": "audio_in",
        "description": "Standard audio signal routing"
      },
      {
        "from": "cv_out",
        "to": "cv_in",
        "description": "Control voltage modulation routing"
      },
      {
        "from": "audio_out",
        "to": "cv_in",
        "description": "Audio-rate FM / filter modulation"
      }
    ],
    "rejected_conditions": [
      {
        "code": "self_connection",
        "rule": "source_id == target_id",
        "message": "Cannot patch a socket to itself."
      },
      {
        "code": "unsafe_output_to_output",
        "rule": "source.direction == 'output' and target.direction == 'output'",
        "message": "Unsafe routing: cannot tie two low-impedance outputs together."
      },
      {
        "code": "invalid_input_to_input",
        "rule": "source.direction == 'input' and target.direction == 'input'",
        "message": "Invalid routing: cannot patch two inputs together without a signal source."
      },
      {
        "code": "dc_offset_cv_to_audio_in",
        "rule": "source.port_type == 'cv_out' and target.port_type == 'audio_in'",
        "message": "Rejected: unipolar/low-frequency CV into AC audio input introduces DC thump."
      },
      {
        "code": "unsafe_feedback_loop",
        "rule": "source_id == 'socket_vcf_out' and target_id == 'socket_vcf_in'",
        "message": "Unsafe direct filter feedback loop rejected to prevent runaway self-oscillation clipping."
      }
    ],
    "default_normalled_connections": [
      {
        "from": "socket_vcf_out",
        "to": "socket_vca_in",
        "note": "VCF output is normalled to VCA input unless overridden, while VCO1->VCF requires an explicit patch cable for the signature patch interaction or preset load."
      }
    ],
    "cable_clearance_min_m": 0.012
  },
